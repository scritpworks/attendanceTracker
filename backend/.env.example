# Copy this file to .env and edit for your machine.
# Do not commit real secrets into git.

# Server
PORT=5001
SERVER_URL=http://localhost:5001

# JWT
JWT_SECRET=change-me-to-a-long-random-secret

# MySQL — create this database first, then run database/auth_rbac_schema.sql
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=attendance_tracker

# Pool/timeouts (optional)
DB_CONNECTION_LIMIT=20
DB_ACQUIRE_TIMEOUT_MS=30000
DB_SOCKET_TIMEOUT_MS=30000

# Frontend origin(s) allowed by CORS — comma-separated if needed.
FRONTEND_URL=http://localhost:5174
